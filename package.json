  "type": "module",
  "license": "Apache-2.0",
  "author": "Tabularium AI",
  "repository": {
    "type": "git",
    "url": "https://github.com/TabulariumAI/aurora_analysis.git"
  },
  "bugs": {
    "url": "https://github.com/TabulariumAI/aurora_analysis/issues"
  },
  "homepage": "https://github.com/TabulariumAI/aurora_analysis#readme",
  "keywords": [
    "title-report",
    "title-analysis",
    "document-analysis",
    "document-workflow",
    "react",
    "tabularium-ai"
  ],
  "main": "./src/public-api.ts",
  "module": "./src/public-api.ts",
  "types": "./src/public-api.ts",
  "exports": {
